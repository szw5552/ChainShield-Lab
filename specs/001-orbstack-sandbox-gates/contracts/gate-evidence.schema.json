{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainshield-lab.local/contracts/gate-evidence.schema.json",
  "title": "ChainShield Gate Evidence",
  "description": "Snyk、Socket 或 OpenShell 的正規化 evidence；artifact 必須已清理。",
  "type": "object",
  "required": [
    "gate",
    "run_id",
    "status",
    "source_kind",
    "source_path",
    "command",
    "exit_code",
    "risk_level",
    "reasons",
    "observed_at",
    "sanitized"
  ],
  "additionalProperties": false,
  "properties": {
    "gate": {
      "type": "string",
      "enum": [
        "snyk",
        "socket",
        "openshell"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "deny",
        "manual_review",
        "skipped"
      ]
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "live",
        "fixture",
        "manual_observation"
      ]
    },
    "source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "command": {
      "type": [
        "string",
        "null"
      ],
      "description": "命令摘要不得包含 token 或秘密。"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "sanitized": {
      "type": "boolean",
      "const": true
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Repository-local run_id derived from demo config path, fixture identity, timestamp, and evidence hash."
    },
    "containment_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_type",
          "policy_rule_id",
          "result",
          "timestamp",
          "artifact_path",
          "source_kind",
          "sanitized"
        ],
        "additionalProperties": false,
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "filesystem_read",
              "network_egress"
            ]
          },
          "blocked_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "blocked_target": {
            "type": [
              "string",
              "null"
            ]
          },
          "policy_rule_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "const": "blocked"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "artifact_path": {
            "type": "string",
            "minLength": 1
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "live",
              "fixture"
            ]
          },
          "sanitized": {
            "type": "boolean",
            "const": true
          }
        }
      }
    }
  }
}
