{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainshield-lab.local/contracts/demo-config.schema.json",
  "title": "ChainShield Demo Config",
  "description": "版本控管的展示設定檔；不得包含 token、憑證或真實秘密。",
  "type": "object",
  "required": [
    "version",
    "request_id",
    "package_manager",
    "scanner_mode",
    "sandbox_mode",
    "fixtures",
    "outputs",
    "safety"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "package_manager": {
      "type": "string",
      "const": "npm"
    },
    "scanner_mode": {
      "type": "object",
      "required": [
        "snyk",
        "socket"
      ],
      "additionalProperties": false,
      "properties": {
        "snyk": {
          "type": "string",
          "enum": [
            "fixture",
            "live",
            "skip"
          ]
        },
        "socket": {
          "type": "string",
          "enum": [
            "fixture",
            "live",
            "skip"
          ]
        }
      }
    },
    "sandbox_mode": {
      "type": "string",
      "enum": [
        "disabled",
        "fixture",
        "live"
      ]
    },
    "fixtures": {
      "type": "object",
      "required": [
        "poc_app",
        "malicious_package",
        "snyk_report",
        "socket_report",
        "openshell_log",
        "canary_secret"
      ],
      "additionalProperties": false,
      "properties": {
        "poc_app": {
          "type": "string",
          "minLength": 1
        },
        "malicious_package": {
          "type": "string",
          "minLength": 1
        },
        "snyk_report": {
          "type": [
            "string",
            "null"
          ]
        },
        "socket_report": {
          "type": [
            "string",
            "null"
          ]
        },
        "openshell_log": {
          "type": [
            "string",
            "null"
          ]
        },
        "canary_secret": {
          "type": [
            "string",
            "null"
          ]
        },
        "openshell_policy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "required": [
        "decision_json",
        "markdown_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "decision_json": {
          "type": "string",
          "minLength": 1
        },
        "markdown_summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "sandbox_demo_override",
        "synthetic_egress_target"
      ],
      "additionalProperties": false,
      "properties": {
        "synthetic_egress_target": {
          "type": "string",
          "const": "https://chainshield-egress-test.invalid/collect",
          "description": "Canonical reserved invalid target for synthetic egress blocking demos."
        },
        "sandbox_demo_override": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 10
                  }
                }
              }
            }
          ]
        }
      }
    },
    "worker_provider": {
      "type": "object",
      "required": [
        "enabled",
        "primary",
        "fallbacks",
        "timeout_seconds",
        "output_path"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "primary": {
          "type": "string",
          "enum": [
            "nemotron_api",
            "disabled"
          ]
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "codex_subagent",
              "claude_subagent"
            ]
          },
          "uniqueItems": true
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "output_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "primary": {
                "const": "nemotron_api"
              },
              "output_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
