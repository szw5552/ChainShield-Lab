{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainshield-lab.local/contracts/supervisor-decision.schema.json",
  "title": "ChainShield Supervisor Decision",
  "description": "Supervisor 彙整 Gate 證據後產生的機器可讀決策檔。",
  "type": "object",
  "required": ["request_id", "decision", "summary", "primary_reasons", "gate_results", "missing_gates", "next_actions", "generated_at", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "enum": ["allow", "deny", "manual_review"] },
    "summary": { "type": "string", "minLength": 1 },
    "primary_reasons": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "gate_results": {
      "type": "array",
      "items": { "$ref": "gate-evidence.schema.json" }
    },
    "missing_gates": {
      "type": "array",
      "items": { "type": "string", "enum": ["snyk", "socket", "openshell"] }
    },
    "next_actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "object",
      "required": ["decision_json", "markdown_summary", "reports", "logs"],
      "additionalProperties": false,
      "properties": {
        "decision_json": { "type": "string", "minLength": 1 },
        "markdown_summary": { "type": ["string", "null"] },
        "reports": { "type": "array", "items": { "type": "string" } },
        "logs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
